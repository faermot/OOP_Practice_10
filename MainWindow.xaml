<Window x:Class="OOP_Practice_10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOP_Practice_10"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:uc="clr-namespace:OOP_Practice_10.UserControls"
        mc:Ignorable="d"
        Height="720" Width="1130"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#F4F4F4"
                CornerRadius="30 0 0 30"
                BorderThickness="0 0 1 0"
                BorderBrush="#D9D9D9">
            <Grid>
                <Button Style="{StaticResource manuButtonTop}">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="5" Opacity="0.1"/>
                    </Button.Effect>
                    <TextBlock Text="29"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0 0 0 2"
                               Foreground="#2F394E"/>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource menuButton}">
                        <fa:ImageAwesome Icon="Book" Style="{StaticResource manuButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource menuButton}">
                        <fa:ImageAwesome Icon="PieChart" Style="{StaticResource manuButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource menuButton}">
                        <fa:ImageAwesome Icon="Comment" Style="{StaticResource manuButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource menuButton}">
                        <fa:ImageAwesome Icon="Cog" Style="{StaticResource manuButtonIcon}"/>
                    </Button>
                </StackPanel>

                <Button Style="{StaticResource menuButton}"
                        VerticalAlignment="Bottom"
                        Margin="0 0 0 15">
                    <fa:ImageAwesome Icon="PowerOff" Style="{StaticResource manuButtonIcon}"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#F4F4F4"
                CornerRadius="0 30 30 0"
                MouseDown="Border_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#2F394E" CornerRadius="0 30 0 0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="75 0 0 40">

                        <Grid VerticalAlignment="Center"
                              Width="180" Height="180">
                            <lvc:PieChart LegendLocation="None"
                                          InnerRadius="80"
                                          Hoverable="False"
                                          Height="180"
                                          DataTooltip="{x:Null}">
                                <lvc:PieChart.Series>
                                    <lvc:PieSeries Values="2" StrokeThickness="0" Fill="#FFBE41"/>
                                    <lvc:PieSeries Values="2" StrokeThickness="0" Fill="#DFE931"/>
                                    <lvc:PieSeries Values="1.5" StrokeThickness="0" Fill="Transparent"/>
                                    <lvc:PieSeries Values="2" StrokeThickness="0" Fill="#664BFB"/>
                                </lvc:PieChart.Series>
                            </lvc:PieChart>

                            <Border CornerRadius="100"
                                    Background="#FFFFFF"
                                    Width="145" Height="145"
                                    Padding="5">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Images/p4.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>
                        </Grid>

                        <TextBlock Text="79"
                                   Foreground="#FFFFFF"
                                   FontSize="90"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="50 0 30 10"/>

                        <StackPanel VerticalAlignment="Center" Margin="0 0 0 10">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#FFFFFF"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Text="Прогресс обучения"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#E4E5E8"
                                       FontSize="16"
                                       Margin="0 10 0 0"
                                       FontWeight="SemiBold"
                                       Text="Практическая работа №10"/>
                        </StackPanel>

                        <StackPanel Margin="30 0 0 10" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource infoTitle}">
                                <Run>10.5</Run>
                                <Run FontWeight="Light" FontSize="20">ч</Run>
                            </TextBlock>
                            <TextBlock Text="На прошлой неделе"
                                       Style="{StaticResource infoText}"/>
                            <Grid Width="80" Height="40" Margin="0 0 5 0">
                                <lvc:CartesianChart>
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis ShowLabels="False">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis ShowLabels="False" MinValue="-8" MaxValue="50">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                    <lvc:CartesianChart.Series>
                                        <lvc:LineSeries StrokeThickness="1"
                                                        Stroke="#787C86"
                                                        PointGeometrySize="0"
                                                        Values="0,10,20,15,40,30,45,30">
                                            <lvc:LineSeries.Fill>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#5C785C" Offset="0.4"/>
                                                    <GradientStop Color="#405051" Offset="1.2"/>
                                                </LinearGradientBrush>
                                            </lvc:LineSeries.Fill>
                                        </lvc:LineSeries>
                                    </lvc:CartesianChart.Series>
                                </lvc:CartesianChart>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="15 0 15 10" VerticalAlignment="Center">
                            <Rectangle VerticalAlignment="Stretch"
                                       Width="0.8"
                                       Stroke="#414C61"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 0 10" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource infoTitle}">
                                <Run>30.9</Run>
                                <Run FontWeight="Light" FontSize="20">ч</Run>
                            </TextBlock>
                            <TextBlock Text="В прошлом месяце"
                                       Style="{StaticResource infoText}"/>
                            <Grid Width="80" Height="40" Margin="0 0 5 0">
                                <lvc:CartesianChart>
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis ShowLabels="False">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis ShowLabels="False" MinValue="-7" MaxValue="50">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator StrokeThickness="0"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                    <lvc:CartesianChart.Series>
                                        <lvc:LineSeries StrokeThickness="1"
                                                        Stroke="#FF829A"
                                                        PointGeometrySize="0"
                                                        Values="0,10,20,22,30,25,45,38">
                                            <lvc:LineSeries.Fill>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#6D4F65" Offset="0.4"/>
                                                    <GradientStop Color="#484257" Offset="1.2"/>
                                                </LinearGradientBrush>
                                            </lvc:LineSeries.Fill>
                                        </lvc:LineSeries>
                                    </lvc:CartesianChart.Series>
                                </lvc:CartesianChart>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="20 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="20 60 20 40">
                        <Grid>
                            <TextBlock Text="Моя команда: "
                                       Foreground="#787C86"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <Border Background="#787C86"
                                    CornerRadius="50"
                                    Width="25" Height="25"
                                    HorizontalAlignment="Right">
                                <fa:ImageAwesome Icon="Play"
                                                 Foreground="White"
                                                 Width="7"
                                                 Margin="2 0 0 0"/>
                            </Border>
                        </Grid>

                        <Separator Foreground="#787C86" Height="0.7" Margin="0 10 0 10"/>

                        <uc:TeamUserControl Title="Тест Тестов" Num="74" Source="/Images/p1.png"/>
                        <uc:TeamUserControl Title="Тест Тестов" Num="69" Source="/Images/p2.png"/>
                        <uc:TeamUserControl Title="Тест Тестов" Num="94" Source="/Images/p3.png"/>
                    </StackPanel>

                    <Button Style="{StaticResource pinkButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Совершенствуй свои навыки"
                                       Margin="0 0 15 1"/>
                            <fa:ImageAwesome Icon="Plug"
                                             Width="10"
                                             Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#FFFFFF"
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="30 20 30 20"
                            CornerRadius="20"
                            Margin="20 -60 20 40">
                        <StackPanel>
                            <TextBlock Text="Основные навыки:"
                                       Style="{StaticResource title}"/>
                            <TextBlock Style="{StaticResource description}">
                                <Run>Улучшение на </Run>
                                <Run Foreground="#6D4F65">12%</Run>
                                <Run>с прошлой недели</Run>
                            </TextBlock>

                            <Grid Margin="0 38">
                                <lvc:PieChart LegendLocation="None"
                                              InnerRadius="80"
                                              Hoverable="False"
                                              Height="150"
                                              DataTooltip="{x:Null}">
                                    <lvc:PieChart.Series>
                                        <lvc:PieSeries Values="1" StrokeThickness="0" Fill="#6D4F65"/>
                                        <lvc:PieSeries Values="1" StrokeThickness="0" Fill="#787C86"/>
                                        <lvc:PieSeries Values="1" StrokeThickness="0" Fill="#5C785C"/>
                                    </lvc:PieChart.Series>
                                </lvc:PieChart>
                                <TextBlock Text="79"
                                           FontSize="44"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0 0 0 20"/>
                                <TextBlock Text="Прогресс 12%"
                                           Foreground="#9CA2B3"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0 45 0 0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <uc:InfoUserControl Grid.Column="0"
                                                    Color="#6D4F65"
                                                    Title="UX - дизайн"
                                                    Description="25%"/>
                                <uc:InfoUserControl Grid.Column="1"
                                                    Color="#787C86"
                                                    Title="Веб - раз"
                                                    Description="35%"/>
                                <uc:InfoUserControl Grid.Column="2"
                                                    Color="#5C785C"
                                                    Title="C#"
                                                    Description="40%"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF"
                            Grid.Row="1"
                            Grid.Column="2"
                            Padding="30 20 30 20"
                            CornerRadius="20"
                            Margin="20 -60 20 40">
                        <StackPanel>
                            <TextBlock Text="Следующий курс:"
                                       Style="{StaticResource title}"/>
                            <TextBlock Style="{StaticResource description}">
                                <Run>Рассчитан на </Run>
                                <Run Foreground="#6D4F65">5.5ч</Run>
                                <Run>на эту неделю</Run>
                            </TextBlock>

                            <uc:LessonUserControl Color="#664BFB"
                                                   Title="Продвинутый курс по React"
                                                   Description="Спикер - Тест Тестов"
                                                   Margin="0 10 0 0"/>
                            <uc:LessonUserControl Color="#664BFB"
                                                   Title="Продвинутый курс по React"
                                                   Description="Спикер - Тест Тестов"/>
                            <uc:LessonUserControl Color="#664BFB"
                                                   Title="Продвинутый курс по React"
                                                   Description="Спикер - Тест Тестов"/>
                            <uc:LessonUserControl Color="#664BFB"
                                                   Title="Продвинутый курс по React"
                                                   Description="Спикер - Тест Тестов"/>

                            <Button Content="Посмотреть учебный план"
                                    Style="{StaticResource whiteButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
